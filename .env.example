# ============================================================
# code-review-agent  环境变量样板
#   用法: cp .env.example .env  按需修改
#   说明: Provider (baseUrl / authToken / model) 由请求体注入,
#         本文件不放任何密钥,可安全提交到仓库。
# ============================================================

# ---------- 运行时(同时被 docker compose 与本地 node 读取)----------
NODE_ENV=production
# 容器内 Express 监听端口,同时被 healthcheck 探测使用
PORT=3000
# 时区,影响日志时间戳
TZ=Asia/Shanghai
# Claude Code CLI 二进制路径,生产镜像由 Dockerfile 装到 /usr/local/bin/claude;
# 本地开发若用 npx/native installer 装在别处,可在此覆盖
# CLAUDE_CODE_BIN=/usr/local/bin/claude

# ---------- 仅 docker compose 使用 ----------
# 镜像地址与 tag(由 GitHub Actions 推送到阿里云 ACR)
# 想固定到某次 commit: IMAGE_TAG=<git-sha>
IMAGE=registry.cn-shanghai.aliyuncs.com/vagent/code-review-agent
IMAGE_TAG=latest
# 宿主机映射端口(改这里不用动 compose 文件)
HOST_PORT=3000
# 克隆仓库在宿主机上的目录(相对 compose 文件位置)
WORKSPACE_DIR=./workspace
# 资源上限——Claude SDK 子进程 + git clone 大仓时内存会冲高,按需调整
CPU_LIMIT=2.0
MEMORY_LIMIT=2g
MEMORY_RESERVATION=512m
# 容器日志滚动策略,防止 SSE 长跑撑爆磁盘
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5

# ---------- 仅本地调试(直接 node dist/server.js)使用 ----------
# 生产环境绝不写入镜像或配置文件;通过 Spring Boot 调用时由请求 body 注入。
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
