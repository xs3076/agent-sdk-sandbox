# ============================================================
# agent-sdk-sandbox  环境变量样板
#   用法: cp .env.example .env  按需修改
#   说明: Provider (baseUrl / authToken / model) 由请求体注入,
#         本文件不放任何密钥,可安全提交到仓库。
# ============================================================

# ---------- 运行时(同时被 docker compose 与本地 node 读取)----------
NODE_ENV=production
# 容器内 Express 监听端口,同时被 healthcheck 探测使用
PORT=3000
# 时区,影响日志时间戳
TZ=Asia/Shanghai

# ---------- 仅 docker compose 使用 ----------
# 镜像地址与 tag(由 GitHub Actions 推送到阿里云 ACR)
# 想固定到某次 commit: IMAGE_TAG=<git-sha>
IMAGE=registry.cn-shanghai.aliyuncs.com/vagent/agent-sdk-sandbox
IMAGE_TAG=latest
# 宿主机映射端口(改这里不用动 compose 文件)
HOST_PORT=3000
# 克隆仓库在宿主机上的目录(相对 compose 文件位置)
WORKSPACE_DIR=./workspace
# skills 目录在宿主机上的位置;后期加 skill 只需在此目录新增子目录并重启容器,无需重建镜像
SKILLS_DIR=./skills
# 资源上限——Claude SDK 子进程 + git clone 大仓时内存会冲高,按需调整
CPU_LIMIT=2.0
MEMORY_LIMIT=2g
MEMORY_RESERVATION=512m
# 容器日志滚动策略,防止 SSE 长跑撑爆磁盘
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
